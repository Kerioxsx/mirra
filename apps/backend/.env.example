# Copy to .env for local development. Never commit real secrets.
MIRRA_ENV=development
MIRRA_DATABASE_URL=postgresql+asyncpg://mirra:mirra@localhost:5432/mirra
MIRRA_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MIRRA_JWT_SECRET=change-me-dev-only-secret-at-least-32-characters
MIRRA_CORS_ORIGINS=["http://localhost:3000","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]
# Marketplace credentials (Phase 2)
MIRRA_EBAY_CLIENT_ID=
MIRRA_EBAY_CLIENT_SECRET=
MIRRA_EBAY_MARKETPLACE_ID=EBAY_US
MIRRA_DEMO_CONNECTOR_ENABLED=true
# Taobao (priority) — overseas affiliate API. See docs/architecture/taobao.md
MIRRA_TAOBAO_APP_KEY=
MIRRA_TAOBAO_APP_SECRET=
MIRRA_TAOBAO_ADZONE_ID=
MIRRA_TAOBAO_SIGN_METHOD=md5
MIRRA_TAOBAO_LANGUAGE=en_US
# Taobao Global Open Platform (distributors; image search, dropship) — after approval
MIRRA_TAOBAO_GLOBAL_APP_KEY=
MIRRA_TAOBAO_GLOBAL_APP_SECRET=
# Prices: ECB reference rates; optional forwarding rate enables delivered-cost estimates
MIRRA_FX_SOURCE=ecb
MIRRA_FORWARDING_RATE_PER_KG=
MIRRA_FORWARDING_CURRENCY=USD

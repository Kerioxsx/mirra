# Copy to .env for local development. Never commit real secrets.
MIRRA_ENV=development
MIRRA_DATABASE_URL=postgresql+asyncpg://mirra:mirra@localhost:5432/mirra
MIRRA_REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MIRRA_JWT_SECRET=change-me-dev-only-secret-at-least-32-characters
MIRRA_CORS_ORIGINS=["http://localhost:3000","tauri://localhost","http://tauri.localhost","https://tauri.localhost"]
# Marketplace credentials (Phase 2)
MIRRA_EBAY_CLIENT_ID=
MIRRA_EBAY_CLIENT_SECRET=
MIRRA_EBAY_MARKETPLACE_ID=EBAY_US
MIRRA_DEMO_CONNECTOR_ENABLED=true

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirra",
  "version": "0.1.0",
  "identifier": "app.mirra.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @mirra/web dev",
    "beforeBuildCommand": "pnpm --filter @mirra/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Mirra",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#0e0e10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:8000 http://127.0.0.1:8000",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "AI fashion dresser",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
